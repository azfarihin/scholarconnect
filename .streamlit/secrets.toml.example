# Copy this file to .streamlit/secrets.toml on your laptop,
# or paste the same contents into Streamlit Cloud: app ⋮ → Settings → Secrets.
# Never upload secrets.toml to GitHub (.gitignore already blocks it).

sheet_url = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"

# A long random string. Keeps students signed in when the app restarts.
cookie_secret = "paste-a-long-random-string-here"

# FOR TESTING ONLY: show sign-in codes on screen instead of emailing them.
# Set to false (or delete this line) before students use the site.
otp_test_mode = false

# The email account that sends sign-in codes. Ask DxD which sender to use.
[smtp]
host = "smtp.example.com"
port = 587
username = "sender@example.com"
password = "app-password"
sender = "ScholarConnect <sender@example.com>"

# Staff sign-in for /staff: one line per staff member, email = "password"
[staff_accounts]
"officer1@example.com" = "choose-a-strong-password"

# Paste the values from the Google Cloud service account JSON key.
# Share the Google Sheet (sheet_url above) with client_email as Editor.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
